{
  "workspace": [
    "./shared",
    "./server"
  ],
  "tasks": {
    "check": "deno check shared/ server/",
    "test": "deno test shared/ server/",
    "fmt": "deno fmt",
    "lint": "deno lint",
    "gate": "deno fmt --check && deno lint && deno task check && deno task test"
  },
  "fmt": {
    "lineWidth": 100,
    "singleQuote": false,
    "exclude": [
      "**/*.md"
    ]
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ]
    }
  },
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true
  },
  "unstable": [
    "temporal"
  ]
}
