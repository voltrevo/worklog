node_modules/
dist/
*.log

# KPS identity — the certhash is the server's identity, so this must never be committed.
kps-cert.pem
kps-key.pem

# Server state.
*.sqlite
*.sqlite-journal
*.sqlite-wal
data/

# Vite output, and the seeded databases the browser harnesses make. Both harnesses remove theirs on
# the way out; these catch the run that was interrupted before it could.
web/dist/
.screenshots-data/
.journey-data/

# Built desktop apps: `deno task desktop`, `deno task desktop:build`, `deno task desktop:check`.
worklog-dev/
Worklog/
Worklog.app/
worklog-check/
# Left by an older name for `desktop:check`; kept so a stale directory cannot be committed again.
.desktop-selftest/
